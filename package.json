{
  "name": "career-wings-whatsapp-sender",
  "version": "1.0.0",
  "description": "Career Wings WhatsApp desktop campaign sender",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "in.careerwings.whatsappsender",
    "productName": "Career Wings WhatsApp Sender",
    "files": ["main.js","preload.js","renderer/**","package.json"],
    "win": {"target": "nsis"},
    "nsis": {"oneClick": false,"perMachine": false,"allowToChangeInstallationDirectory": true}
  }
}